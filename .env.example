# DAYBREAK environment — copy to .env.local (never commit real values).
# Everything is optional: with nothing set, DAYBREAK runs with live RSS news, demo-mode storage
# and no AI. See README → Configuration.

# --- Supabase (accounts + durable storage) ---------------------------------
# All three are needed; if any is missing the app runs in labelled demo mode.
NEXT_PUBLIC_SUPABASE_URL=
# Public by design (restricted by Row Level Security). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Never give it a NEXT_PUBLIC_ name (those are shipped to browsers).
# SUPABASE_SECRET_KEY is accepted as an alternative name.
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model (optional; required by the production deploy gate) ------
# anthropic | openai | google | gateway | none   (unset = first provider with a key)
# On Vercel, LLM_PROVIDER=gateway works without any key (Vercel OIDC).
LLM_PROVIDER=
# e.g. claude-haiku-5-5 (anthropic) or anthropic/claude-haiku-5.5 (gateway)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
# LLM_TIMEOUT_MS=30000
# LLM_MAX_OUTPUT_TOKENS=4000

# --- Scheduled jobs (required by the production deploy gate) ----------------
# Long random string; Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=
# CRON_USE_AI=true

# --- News & tuning -----------------------------------------------------------------
# live (default) | sample (labelled offline demo data)
NEWS_MODE=live
# DATA_DIR=.data
# FEED_FRESH_MINUTES=30
# POOL_STALE_MINUTES=90
# REGENERATE_COOLDOWN_SECONDS=45
# CANDIDATE_HOURS=48
# CRON_EDITIONS_PER_RUN=20
