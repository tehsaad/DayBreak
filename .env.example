# DAYBREAK — environment template. Copy to .env.local for local use; NEVER commit real values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Everything is optional for local development: with nothing set, DAYBREAK runs with live RSS
# news, demo-mode storage and no AI. Full guide: docs/API_KEYS.md

# ─── Supabase (accounts + database "memory") ──────────────────────────────────
# All three are needed; if any is missing the app runs in labelled demo mode.
NEXT_PUBLIC_SUPABASE_URL=
# Public by design (restricted by Row Level Security). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Never give it a NEXT_PUBLIC_ name (those are shipped to browsers).
# SUPABASE_SECRET_KEY is accepted as an alternative name.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Gemini / Google AI Studio (AI summaries and analysis) ─────────────────────
# One key from https://aistudio.google.com/apikey. Any ONE of these names works:
# GOOGLE_GENERATIVE_AI_API_KEY, GEMINI_API_KEY, GOOGLE_AI_STUDIO_API_KEY.
GEMINI_API_KEY=
# Groq (fast summaries; preferred when set). Default model openai/gpt-oss-120b (Groq production
# model list, Oct 2026). Gemini (GEMINI_API_KEY) is used as the automatic fallback when both are set.
GROQ_API_KEY=
GROQ_MODEL=
# Fallback provider when the primary fails ("none" disables). Defaults to the next provider with a key.
LLM_FALLBACK_PROVIDER=
# Cost controls: simultaneous LLM calls per instance, and articles pre-summarised per ingestion run.
LLM_CONCURRENCY=4
AI_SUMMARIES_PER_RUN=40
# Optional: pin the provider/model (e.g. LLM_PROVIDER=google, LLM_MODEL=gemini-3.5-flash).
LLM_PROVIDER=
LLM_MODEL=
# Other providers (optional): ANTHROPIC_API_KEY, OPENAI_API_KEY, AI_GATEWAY_API_KEY.
# On Vercel, LLM_PROVIDER=gateway works without any key (Vercel OIDC; needs a card on file).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# LLM_TIMEOUT_MS=30000
# LLM_MAX_OUTPUT_TOKENS=4000

# ─── GNews (extra news source, optional) ──────────────────────────────────────
# Key from https://gnews.io. Adds GNews top headlines (8 categories) to the RSS feeds.
# Free plan: 100 requests/day; DAYBREAK uses ~64/day at the default interval.
GNEWS_API_KEY=
# GNEWS_FRESH_MINUTES=180

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Server-only. Used for the one-time welcome email after a first Google sign-in.
# (Supabase's own auth emails go through Resend SMTP, configured in the Supabase dashboard —
#  see docs/EMAIL_SETUP.md; those settings are not environment variables.)
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. DAYBREAK <hello@tehsaad.site>
RESEND_FROM_EMAIL=

# ─── Scheduled jobs (required by the production deploy gate) ─────────────────
# Long random string (e.g. `openssl rand -hex 32`). Already set in Vercel production.
CRON_SECRET=
# CRON_USE_AI=true

# ─── Vercel hosting (GitHub Actions secrets — NOT app variables) ─────────────────
# These go in GitHub → repo Settings → Secrets and variables → Actions, not in this file:
#   VERCEL_TOKEN       (Vercel → Account Settings → Tokens)
#   VERCEL_ORG_ID      (Vercel team ID)
#   VERCEL_PROJECT_ID  (Vercel project ID; also in .vercel/project.json after `vercel link`)

# ─── News & tuning ─────────────────────────────────────────────────────────────────
# live (default) | sample (labelled offline demo data)
NEWS_MODE=live
# DATA_DIR=.data
# FEED_FRESH_MINUTES=30
# POOL_STALE_MINUTES=90
# REGENERATE_COOLDOWN_SECONDS=45
# CANDIDATE_HOURS=48
# CRON_EDITIONS_PER_RUN=20
